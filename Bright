-- ════════════════════════════════════════════════════════════════
--  🧹 Limpar todos os filhos do Lighting (anti-lag inicial)
-- ════════════════════════════════════════════════════════════════
local function LimparLighting()
	local removidos = 0
	for _, filho in ipairs(Lighting:GetChildren()) do
		filho:Destroy()
		removidos += 1
	end
	if removidos > 0 then
		print(string.format(
			"  🧹 [Lighting] %d efeito(s) removido(s)! Bye bye lag~ 👋",
			removidos
		))
	end
end


-- ════════════════════════════════════════════════════════════════
--  ⚙️  Aplicar todas as propriedades base do Lighting
-- ════════════════════════════════════════════════════════════════
local function ConfigurarLighting()
	Lighting.Ambient                  = configBright.Ambient
	Lighting.OutdoorAmbient           = configBright.OutdoorAmbient
	Lighting.ColorShift_Bottom        = configBright.ColorShift_Bottom
	Lighting.ColorShift_Top           = configBright.ColorShift_Top
	Lighting.Brightness               = configBright.Brightness
	Lighting.EnvironmentSpecularScale = configBright.EnvironmentSpecularScale
	Lighting.EnvironmentDiffuseScale  = configBright.EnvironmentDiffuseScale
	Lighting.GlobalShadows            = configBright.GlobalShadows  -- 🚫 sempre false
	Lighting.ShadowSoftness           = configBright.ShadowSoftness -- 🚫 sempre 0
	Lighting.GeographicLatitude       = configBright.GeographicLatitude
	Lighting.Technology               = configBright.Technology
	Lighting.FogColor                 = configBright.FogColor
	Lighting.FogStart                 = configBright.FogStart
	Lighting.FogEnd                   = configBright.FogEnd
end


-- ════════════════════════════════════════════════════════════════
--  🚫🌑 FUNÇÃO: Remover TODAS as sombras do Workspace
--
--  Percorre todos os descendentes e força:
--  → BasePart.CastShadow  = false  (peças não projetam sombra)
--
--  Isso garante que NENHUMA peça, modelo ou personagem
--  projete ou receba qualquer tipo de sombra no jogo.
-- ════════════════════════════════════════════════════════════════
local totalSombrasRemovidas = 0

local function RemoverTodasSombras()
	if not configBright.ForcarSemSombra then return end

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			if obj.CastShadow == true then
				obj.CastShadow = false
				totalSombrasRemovidas += 1
			end
		end
	end
end

-- 🔔 Watcher: novas partes adicionadas ao Workspace também perdem sombra
local function IniciarWatcherSombras()
	if not configBright.ForcarSemSombra then return end

	workspace.DescendantAdded:Connect(function(obj)
		if obj:IsA("BasePart") then
			task.defer(function()
				if obj and obj.Parent then
					obj.CastShadow = false
				end
			end)
		end
	end)

	print("  🚫 [Sombras] Watcher ativo! Novas partes = sem sombra automático~ 🌑❌")
end


-- ════════════════════════════════════════════════════════════════
--  ☀️  Exposure de DIA (sem sombras)
-- ════════════════════════════════════════════════════════════════
local function SetDayExposure()
	Lighting.ExposureCompensation = configBright.ExposureDay
	Lighting.GlobalShadows        = configBright.SombrasOnDay   -- 🚫 false
end


-- ════════════════════════════════════════════════════════════════
--  🌙 Exposure de NOITE (sem sombras)
-- ════════════════════════════════════════════════════════════════
local function SetNightExposure()
	Lighting.ExposureCompensation = configBright.ExposureNight
	Lighting.GlobalShadows        = configBright.SombrasOnNight  -- 🚫 false
end


-- ════════════════════════════════════════════════════════════════
--  🌅 Detectar ciclo e aplicar exposure correta
-- ════════════════════════════════════════════════════════════════
local periodoAtual = ""

local function AtualizarExposure()
	local hora = Lighting.ClockTime

	if hora >= configBright.DayStart and hora < configBright.NightStart then
		if periodoAtual ~= "dia" then
			periodoAtual = "dia"
			SetDayExposure()
			print(string.format(
				"  ☀️  [Exposure] DIA! Exposure: %.1f | Sombras: NENHUMA 🚫🌑",
				configBright.ExposureDay
			))
		end
	else
		if periodoAtual ~= "noite" then
			periodoAtual = "noite"
			SetNightExposure()
			print(string.format(
				"  🌙 [Exposure] NOITE! Exposure: %.1f | Sombras: NENHUMA 🚫🌑",
				configBright.ExposureNight
			))
		end
	end
end


-- ════════════════════════════════════════════════════════════════
--  🔍 Verificar se uma classe é bloqueada
-- ════════════════════════════════════════════════════════════════
local function ClasseBloqueada(objeto)
	for _, classe in ipairs(configBright.ClassesBloqueadas) do
		if objeto:IsA(classe) then
			return true, classe
		end
	end
	if objeto:IsA("PostEffect") then return true, "PostEffect (genérico)" end
	if objeto:IsA("Sky")        then return true, "Sky"                   end
	if objeto:IsA("Atmosphere") then return true, "Atmosphere"            end
	return false, nil
end


-- ════════════════════════════════════════════════════════════════
--  🔒 Detectar e bloquear propriedades alteradas
-- ════════════════════════════════════════════════════════════════
local propriedadesProtegidas = {
	{ prop = "Ambient",                  chave = "Ambient" },
	{ prop = "OutdoorAmbient",           chave = "OutdoorAmbient" },
	{ prop = "ColorShift_Bottom",        chave = "ColorShift_Bottom" },
	{ prop = "ColorShift_Top",           chave = "ColorShift_Top" },
	{ prop = "Brightness",               chave = "Brightness" },
	{ prop = "EnvironmentSpecularScale", chave = "EnvironmentSpecularScale" },
	{ prop = "EnvironmentDiffuseScale",  chave = "EnvironmentDiffuseScale" },
	{ prop = "GlobalShadows",            chave = "GlobalShadows" },
	{ prop = "ShadowSoftness",           chave = "ShadowSoftness" },
	{ prop = "GeographicLatitude",       chave = "GeographicLatitude" },
	{ prop = "FogColor",                 chave = "FogColor" },
	{ prop = "FogStart",                 chave = "FogStart" },
	{ prop = "FogEnd",                   chave = "FogEnd" },
	{ prop = "Technology",               chave = "Technology" },
}

local function DetectarPropriedades()
	if not configBright.AntiTamperAtivo then return end

	for _, entrada in ipairs(propriedadesProtegidas) do
		local valorAtual = Lighting[entrada.prop]
		local valorCerto = configBright[entrada.chave]

		if valorAtual ~= valorCerto then
			Lighting[entrada.prop] = valorCerto

			if configBright.LogarDeteccoes then
				print(string.format(
					"  🔒 [AntiTamper] ⚠️  '%s' alterada! Revertida! 🛡️",
					entrada.prop
				))
			end
		end
	end
end


-- ════════════════════════════════════════════════════════════════
--  🚫 Detectar e destruir filhos com classes bloqueadas
-- ════════════════════════════════════════════════════════════════
local function DetectarFilhos()
	if not configBright.AntiTamperAtivo or not configBright.BloqueioFilhos then return end

	for _, filho in ipairs(Lighting:GetChildren()) do
		local bloqueado, classeDetectada = ClasseBloqueada(filho)
		local nome   = filho.Name
		local classe = filho.ClassName
		filho:Destroy()

		if configBright.LogarDeteccoes then
			if bloqueado then
				print(string.format(
					"  🚫 [AntiTamper] Classe '%s' [%s] destruída! 💥",
					nome, classeDetectada
				))
			else
				print(string.format(
					"  ⚠️  [AntiTamper] Objeto desconhecido '%s' [%s] removido! 🧹",
					nome, classe
				))
			end
		end
	end
end


-- ════════════════════════════════════════════════════════════════
--  🔔 Watcher de classes no Lighting (instantâneo)
-- ════════════════════════════════════════════════════════════════
local function IniciarWatcherFilhos()
	if not configBright.AntiTamperAtivo or not configBright.BloqueioFilhos then return end

	Lighting.ChildAdded:Connect(function(filho)
		task.defer(function()
			if not filho or filho.Parent ~= Lighting then return end

			local bloqueado, classeDetectada = ClasseBloqueada(filho)
			local nome   = filho.Name
			local classe = filho.ClassName
			filho:Destroy()

			if configBright.LogarDeteccoes then
				if bloqueado then
					print(string.format(
						"  🚫 [Watcher] ⚡ Classe proibida '%s' [%s] bloqueada! 💥🔒",
						nome, classeDetectada
					))
				else
					print(string.format(
						"  ⚠️  [Watcher] ⚡ Suspeito '%s' [%s] interceptado! 🧹",
						nome, classe
					))
				end
			end
		end)
	end)

	print("  🔔 [Watcher] Lighting blindado! Qualquer classe será destruída~ ⚡🛡️")
end


-- ════════════════════════════════════════════════════════════════
--  🔄 HEARTBEAT — Atualização automática completa
--  ✅ Lighting  ✅ Exposure  ✅ AntiTamper  ✅ Zero Sombras
-- ════════════════════════════════════════════════════════════════
local function IniciarHeartbeat()
	local acumulador = 0

	RunService.Heartbeat:Connect(function(deltaTime)
		acumulador += deltaTime

		if acumulador >= configBright.HeartbeatInterval then
			acumulador = 0

			ConfigurarLighting()    -- ⚙️  Propriedades base
			AtualizarExposure()     -- 🌅 Ciclo dia/noite
			DetectarPropriedades()  -- 🔒 Reverte alterações
			DetectarFilhos()        -- 🚫 Remove classes bloqueadas
			RemoverTodasSombras()   -- 🌑 Força CastShadow=false em tudo
		end
	end)

	print("  🔄 [Heartbeat] Loop ativo! Intervalo: "
		.. configBright.HeartbeatInterval .. "s 💓")
end


